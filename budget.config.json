{
  "include": [
    "src"
  ],
  "extensions": [
    ".ts",
    ".tsx"
  ],
  "baseline": "budget.txt",
  "title": "Remaining React dependencies in gotolib, on the way to Solid.",
  "tokens": {
    "import:react": "from ['\\\"][^'\\\"]*\\breact\\b[^'\\\"]*['\\\"]",
    "import:react-dom": "from ['\"]react-dom",
    "import:@tanstack/react-router": "from ['\"]@tanstack/react-router['\"]",
    "import:lucide-react": "from ['\"]lucide-react['\"]",
    "hook:useState": "\\buseState\\b",
    "hook:useEffect": "\\buseEffect\\b",
    "hook:useMemo": "\\buseMemo\\b",
    "hook:useCallback": "\\buseCallback\\b",
    "hook:useRef": "\\buseRef\\b",
    "jsx:className": "\\bclassName\\b",
    "type:React.": "\\bReact\\.\\w+",
    "solid:props-destructured": "^export function [A-Z]\\w*\\(\\s*\\{"
  }
}
